# Docker Compose host port only; it is not read by the GoRouter process.
ROUTER_PORT=8090

# The only application secret. Default: secret. Override it outside local use.
# Any random string is accepted; generate one with: openssl rand -base64 33
MASTER_KEY=

# Primary backend: postgresql, clickhouse, or local. Each mode is standalone.
DB_BACKEND=
# PostgreSQL: postgres://user:password@host:5432/database?sslmode=disable
# ClickHouse: clickhouse://user:password@host:9000/database
# Local SQLite default: gorouter.db (plain filesystem path)
DB_CONNECTION_URL=

# Redis connection. Compose reaches it by service name on the internal network.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USER=gorouter
REDIS_PASSWORD=change-me-redis-password

# Optional application settings
LISTEN=:8090
APP_ENV=development
OTEL_SERVICE_NAME=gorouter
DEVELOPMENT_ENVIRONMENT=local
LOG_LEVEL=info
LOG_TIME_FORMAT=rfc3339
OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_PROTOCOL accepts grpc or http.
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# Required only when OTEL_ENABLED=true. Examples: http://otel-agent:4317 for
# gRPC or http://otel-agent:4318 for HTTP/protobuf.
OTEL_EXPORTER_OTLP_ENDPOINT=
REQUEST_TIMEOUT=5m
CACHE_ENABLED=true
CACHE_TTL=24h
CACHE_SCOPE=key
CACHE_MAX_ENTRY_BYTES=1048576
CACHE_MAX_TOTAL_BYTES=268435456
CACHE_MEMORY_FALLBACK=true
REDIS_OUTAGE_POLICY=strict
API_TOKEN_CACHE_TTL=10m
WEEK_START=sunday
USAGE_WRITE_CONCURRENCY=4
USAGE_WRITE_QUEUE_SIZE=100000
# Opt-in: stores bounded request/completion bodies encrypted at rest.
ENABLE_STORE_COMPLLETIONS=false
REQUEST_LIMIT_MB=20
# Retry budget for providers without quota-aware account routing. Quota-aware
# accounts get one attempt each, then routing moves to the next account in the
# ordered circle.
ROUTE_RETRIES=2
ANTHROPIC_OAUTH_CLIENT_ID=9d1c250a-e61b-44d9-88ed-5944d1962f5e
# Optional override for tests or compatible OAuth deployments.
ANTHROPIC_OAUTH_TOKEN_URL=
CODEX_OAUTH_CLIENT_ID=app_EMoamEEZ73f0CkXaXp7hrann
# Optional compatible/test override.
CODEX_OAUTH_TOKEN_URL=

# OpenRouter's public model/pricing catalog is loaded at startup and refreshed hourly.
OPENROUTER_CATALOG_ENABLED=true
OPENROUTER_CATALOG_URL=https://openrouter.ai/api/frontend/v1/catalog/models
OPENROUTER_SYNC_INTERVAL=1h
OPENROUTER_HTTP_TIMEOUT=30s

# Refresh provider-reported metadata for already imported model routes. New
# models remain an explicit import so provider changes cannot widen allowlists.
MODEL_CATALOG_SYNC_ENABLED=true
MODEL_CATALOG_SYNC_INTERVAL=15m
MODEL_CATALOG_CACHE_TTL=1h
# Public OAuth desktop/CLI client identifiers. Override only when using your
# own registered OAuth application.
GITHUB_OAUTH_CLIENT_ID=Iv1.b507a08c87ecfe98
GROK_OAUTH_CLIENT_ID=b1a00492-073a-47ea-816f-4c329264a828
KIMI_CODING_OAUTH_CLIENT_ID=17e5f671-d194-4dfb-9706-5516cb48c098
# Optional overrides; the public Antigravity native-app OAuth client is built in.
ANTIGRAVITY_OAUTH_CLIENT_ID=
ANTIGRAVITY_OAUTH_CLIENT_SECRET=
