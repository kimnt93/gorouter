# The only application secret. Encryption and session-signing keys are derived from it.
# Any random string is accepted; no prefix is required.
# Generate your own with: openssl rand -base64 33
MASTER_KEY=r0ckilsN9MLYexUyybhkkQ5ItF99qtBbasT7acW4486W

# Public application port. Compose binds it on all host interfaces (0.0.0.0).
ROUTER_PORT=8090

# Primary database. PostgreSQL is the transactional backend currently implemented.
# ClickHouse remains an analytics sink and cannot replace PostgreSQL yet.
DB_BACKEND=postgresql
DB_HOST=postgres
DB_PORT=5432
DB_USER=gorouter
DB_PASSWORD=change-me-database-password
DB_NAME=gorouter
# Internal Compose PostgreSQL does not provide TLS. Override for remote TLS databases.
DB_SSLMODE=disable

# Redis connection. Compose reaches it by service name on the internal network.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USER=gorouter
REDIS_PASSWORD=change-me-redis-password

# ClickHouse setup (used by docker-compose.clickhouse.yml)
CLICKHOUSE_PASSWORD=change-me-clickhouse-password
CLICKHOUSE_DB=gorouter
CLICKHOUSE_USER=gorouter

# Optional application settings
LISTEN=:8090
APP_ENV=development
REQUEST_TIMEOUT=5m
CACHE_ENABLED=true
CACHE_TTL=24h
CACHE_SCOPE=key
CACHE_MAX_ENTRY_BYTES=1048576
CACHE_MAX_TOTAL_BYTES=268435456
CACHE_MEMORY_FALLBACK=true
REDIS_OUTAGE_POLICY=strict
REQUEST_LIMIT_MB=20
ANTHROPIC_OAUTH_CLIENT_ID=9d1c250a-e61b-44d9-88ed-5944d1962f5e
# Optional override for tests or compatible OAuth deployments.
ANTHROPIC_OAUTH_TOKEN_URL=
CODEX_OAUTH_CLIENT_ID=app_EMoamEEZ73f0CkXaXp7hrann
# Optional compatible/test override.
CODEX_OAUTH_TOKEN_URL=

# OpenRouter's public model/pricing catalog is loaded at startup and refreshed hourly.
OPENROUTER_CATALOG_ENABLED=true
OPENROUTER_CATALOG_URL=https://openrouter.ai/api/frontend/v1/catalog/models
OPENROUTER_SYNC_INTERVAL=1h
OPENROUTER_HTTP_TIMEOUT=30s
