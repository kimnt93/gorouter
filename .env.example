# The only application secret. Encryption and session-signing keys are derived from it.
# Generate your own with: openssl rand -base64 48
MASTER_KEY=gr_mk_q7N3vY9Kp2Rx8Wc4Lm6Ht1Za5Ds0FjB8Eu3Ci7Go9Vn4Qx2M

# Traefik/web binding. Both *.localhost names resolve to 127.0.0.1.
TRAEFIK_BIND_IP=127.0.0.1
TRAEFIK_HTTP_PORT=80
GOROUTER_HOST=gorouter.localhost
TRAEFIK_DASHBOARD_HOST=traefik.localhost

# Primary database. PostgreSQL is the transactional backend currently implemented.
# ClickHouse remains an analytics sink and cannot replace PostgreSQL yet.
DB_BACKEND=postgresql
DB_HOST=postgres
DB_PORT=5432
DB_USER=gorouter
DB_PASSWORD=change-me-database-password
DB_NAME=gorouter

# Redis connection. Compose reaches it by service name on the internal network.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_USER=gorouter
REDIS_PASSWORD=change-me-redis-password

# ClickHouse setup (used by docker-compose.clickhouse.yml)
CLICKHOUSE_PASSWORD=change-me-clickhouse-password
CLICKHOUSE_DB=gorouter
CLICKHOUSE_USER=gorouter

# Optional application settings
LISTEN=:8090
APP_ENV=development
REQUEST_TIMEOUT=5m
CACHE_ENABLED=true
CACHE_TTL=24h
CACHE_SCOPE=key
CACHE_MAX_ENTRY_BYTES=1048576
CACHE_MAX_TOTAL_BYTES=268435456
CACHE_MEMORY_FALLBACK=true
REDIS_OUTAGE_POLICY=strict
REQUEST_LIMIT_MB=20
ANTHROPIC_OAUTH_CLIENT_ID=9d1c250a-e61b-44d9-88ed-5944d1962f5e
# Optional override for tests or compatible OAuth deployments.
ANTHROPIC_OAUTH_TOKEN_URL=
