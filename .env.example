# Setup secrets. These are required and must be set before starting the stack.
MASTER_KEY=change-me-master-key
ENCRYPTION_KEY=change-me-32-byte-base64-or-passphrase

# Router/web binding
ROUTER_BIND_IP=127.0.0.1
ROUTER_PORT=8090

# PostgreSQL setup
POSTGRES_USER=gorouter
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=gorouter
POSTGRES_BIND_IP=127.0.0.1
POSTGRES_PORT=54329

# Redis setup
REDIS_BIND_IP=127.0.0.1
REDIS_PORT=63899

# ClickHouse setup (used by docker-compose.clickhouse.yml)
CLICKHOUSE_PASSWORD=change-me-clickhouse-password
CLICKHOUSE_DB=gorouter
CLICKHOUSE_USER=gorouter
CLICKHOUSE_BIND_IP=127.0.0.1
CLICKHOUSE_HTTP_PORT=8124
CLICKHOUSE_NATIVE_PORT=9001

# Local binary URLs. Compose overrides these with service DNS names.
DATABASE_URL=postgres://gorouter:change-me-postgres-password@127.0.0.1:54329/gorouter
REDIS_URL=redis://127.0.0.1:63899/0
CLICKHOUSE_URL=http://127.0.0.1:8124
USAGE_BACKEND=postgres

# Optional application settings
LISTEN=:8090
CACHE_ENABLED=true
CACHE_TTL=24h
CACHE_SCOPE=key
REQUEST_LIMIT_MB=20
ANTHROPIC_OAUTH_CLIENT_ID=9d1c250a-e61b-44d9-88ed-5944d1962f5e
